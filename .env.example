PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Diretorios (relativos a raiz do projeto)
DATA_DIR=./data
AUTH_DIR=./auth_info

# Reconexao
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_BASE_DELAY_MS=3000

# Database
DATABASE_URL=postgresql://baileys:baileys_secret@localhost:5432/baileys
POSTGRES_DB=baileys
POSTGRES_USER=baileys
POSTGRES_PASSWORD=baileys_secret

# JWT Auth
JWT_SECRET=change-me-min-32-chars-long-secret
JWT_ACCESS_TTL=15m
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Initial admin seed (used by npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234
ADMIN_DISPLAY_NAME=Administrator
